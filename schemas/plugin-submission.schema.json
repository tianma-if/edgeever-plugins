{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EdgeEver community plugin submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "author", "category", "repositoryUrl", "licenseSpdx", "sourceRevision", "releaseTag", "verification", "admitted"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "repositoryUrl": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$" },
    "licenseSpdx": { "type": "string" },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "releaseTag": { "type": "string" },
    "apiVersion": { "type": "string" },
    "themeApiVersion": { "type": "string" },
    "verification": {
      "type": "object",
      "required": ["version", "checksums"],
      "properties": {
        "version": { "type": "string" },
        "checksums": {
          "type": "object",
          "required": ["manifestJson"],
          "properties": {
            "manifestJson": { "type": "string" },
            "mainJs": { "type": "string" },
            "stylesCss": { "type": "string" }
          }
        }
      }
    },
    "admitted": {
      "type": "object",
      "required": ["permissions", "networkHosts"],
      "properties": {
        "permissions": { "type": "array", "items": { "type": "string" } },
        "networkHosts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": { "enum": ["active", "revoked"] },
    "reason": { "type": "string" },
    "revokedAt": { "type": "string" },
    "locales": { "type": "object" }
  }
}
